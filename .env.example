# Copy to .env (gitignored) and fill in, or export these directly. Nothing
# in this file is a real secret.

# Demo login. DEMO_PASSWORD is hashed once at server startup, so this is
# the plaintext password -- nothing to generate or run. Leave it unset
# (and DEMO_PASSWORD_HASH unset too) and the server prints a one-time
# password to stderr instead. If you'd rather not have a plaintext
# password sitting in .env at all, set DEMO_PASSWORD_HASH instead (see
# README.md for the one-liner that generates one).
DEMO_USERNAME=demo
DEMO_PASSWORD=

# Where the server listens / how it's reachable (issuer + resource server URL).
# Leave MCP_PUBLIC_URL as localhost for Inspector/Claude Code. For Claude
# Desktop over a cloudflared quick tunnel, don't edit this -- run
# `npm run tunnel` instead, which overrides MCP_PUBLIC_URL/MCP_COOKIE_SECURE
# for that run with whatever hostname the tunnel was just assigned (quick
# tunnels get a new one every restart, so a value hardcoded here goes stale
# immediately).
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PUBLIC_URL=http://127.0.0.1:8000

# The one pre-registered OAuth client. Dynamic registration (RFC 7591) is
# also supported now -- see src/auth/provider.ts -- for clients that
# self-register instead, like Claude Desktop/claude.ai connectors.
# http://localhost:6274/oauth/callback is the MCP Inspector's default
# callback; http://localhost:8090/callback matches `claude mcp add
# --callback-port 8090 ...` for connecting from Claude Code (see README.md).
OAUTH_CLIENT_ID=leads-cli
OAUTH_CLIENT_REDIRECT_URIS=http://localhost:6274/oauth/callback,http://localhost:8090/callback
OAUTH_SCOPE=leads:read leads:draft

# Set to true only once this is served over HTTPS -- see src/config.ts.
MCP_COOKIE_SECURE=false
